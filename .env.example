# Optional: enables OpenAI Structured Outputs for the free-description flow.
# Keep this value server-side and never expose it in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Supabase browser connection (Project Settings > API).
# These values are safe to expose to the browser when database RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects use this publishable key name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon key name instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for trusted backend jobs such as catalog ingestion.
# Do not expose this value as NEXT_PUBLIC_* or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: required later for full Steam Web API catalog synchronization.
# Steam Store search and game details currently work without this key.
STEAM_WEB_API_KEY=

# Required only for the protected Steam -> Supabase sync route.
# Generate a long random value and keep it server-side.
STEAM_SYNC_TOKEN=
